{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-branch-isolation.sh\"",
            "timeout": 10,
            "statusMessage": "Checking branch isolation"
          }
        ]
      }
    ]
  }
}
